# syntax=docker/dockerfile:1
#
# Low-memory study runtime: byte-for-byte the runtime stage of
# deploy/build/Dockerfile.tag.aarch64 (the vendor v1.0.0 arm64 image).
#
# The difference from the vendor file is only *where the binary comes from*:
# the vendor builds it in a `public.ecr.aws/zinclabs/rust:trixie-sccache`
# stage, we build it on the GitHub ARM64 runner and hand it in via the build
# context. The three compression libraries the vendor copies out of its
# Debian trixie builder are copied out of a Debian trixie stage here, so the
# runtime filesystem is the same set of files.
#
# Build context: a directory containing just the `openobserve` binary.

FROM debian:trixie-slim AS libs
RUN apt-get update \
    && apt-get install -y --no-install-recommends liblzma5 zlib1g libbz2-1.0 \
    && rm -rf /var/lib/apt/lists/*

FROM gcr.io/distroless/cc-debian13:latest-arm64 AS runtime
COPY openobserve /
COPY --from=libs /lib/aarch64-linux-gnu/liblzma.so.5 /lib/aarch64-linux-gnu/liblzma.so.5
COPY --from=libs /lib/aarch64-linux-gnu/libz.so.1 /lib/aarch64-linux-gnu/libz.so.1
COPY --from=libs /lib/aarch64-linux-gnu/libbz2.so.1.0 /lib/aarch64-linux-gnu/libbz2.so.1.0
RUN ["/openobserve", "init-dir", "-p", "/data/"]
CMD ["/openobserve"]
